# -------------------------------------------------------
# FamilyAdmin — Production Environment Variables
# Copy to .env on the server and fill in all values.
# NEVER commit .env to git.
# -------------------------------------------------------

# Database
POSTGRES_DB=familyadmin
POSTGRES_USER=familyadmin
POSTGRES_PASSWORD=change-me-use-a-strong-password

# JWT — generate with: openssl rand -base64 64
JWT_SECRET=

# Domain
APP_DOMAIN=familyadmin.baier-family.de
APP_FRONTEND_URL=https://familyadmin.baier-family.de
NEXT_PUBLIC_API_URL=https://familyadmin.baier-family.de

# Meta WhatsApp Cloud API
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_VERIFY_TOKEN=

# Mail (SMTP)
MAIL_FROM=
MAIL_PASSWORD=

# Unsplash (recipe photos)
UNSPLASH_ACCESS_KEY=

# AirLabs (flight lookup + status — 1,000 free req/month)
AIRLABS_API_KEY=

# Resend inbound email ingest
INBOUND_EMAIL_DOMAIN=
RESEND_WEBHOOK_SECRET=
