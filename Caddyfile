# Portal and module subdomains share one frontend and one backend (app split, phase 1)
{$APP_DOMAIN}, tasks.{$APP_DOMAIN}, recipes.{$APP_DOMAIN}, travel.{$APP_DOMAIN}, notes.{$APP_DOMAIN}, documents.{$APP_DOMAIN}, finance.{$APP_DOMAIN}, sport.{$APP_DOMAIN} {
    handle /api/* {
        reverse_proxy backend:8080
    }
    handle /uploads/* {
        reverse_proxy backend:8080
    }
    handle {
        reverse_proxy frontend:3000
    }
}

# Former address — 308 keeps the HTTP method, so webhooks and sync scripts that
# still POST to the old host keep working. Keep at least a few months after the move.
{$APP_LEGACY_DOMAIN} {
    redir https://{$APP_DOMAIN}{uri} 308
}
