# One backend for all hosts; each module app gets its own frontend container (app split).
(app) {
    handle /api/* {
        reverse_proxy backend:8080
    }
    handle /uploads/* {
        reverse_proxy backend:8080
    }
    handle {
        reverse_proxy {args[0]}:3000
    }
}

# Portal plus the modules it still renders itself
{$APP_DOMAIN}, tasks.{$APP_DOMAIN}, recipes.{$APP_DOMAIN}, travel.{$APP_DOMAIN}, documents.{$APP_DOMAIN}, finance.{$APP_DOMAIN}, sport.{$APP_DOMAIN} {
    import app frontend
}

notes.{$APP_DOMAIN} {
    import app frontend-notes
}

# Former address — 308 keeps the HTTP method, so webhooks and sync scripts that
# still POST to the old host keep working. Keep at least a few months after the move.
{$APP_LEGACY_DOMAIN} {
    redir https://{$APP_DOMAIN}{uri} 308
}
